# .env.example  — copy to .env.local and fill in

# Neon Postgres: use the POOLED connection string (Neon › Connect › Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# The address you open the site at (no trailing slash). Must match the browser URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Any random text, at least 32 characters. Keep it secret. Changing it signs everyone out.
AUTH_SECRET="change-me-to-a-long-random-string-of-32-plus-characters"
